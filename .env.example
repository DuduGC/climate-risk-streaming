# Copie para .env e preencha as duas senhas antes de iniciar o Compose.
POSTGRES_DB=climate_logistics
POSTGRES_USER=climate_admin
POSTGRES_PASSWORD=
APP_DB_USER=climate_app
APP_DB_PASSWORD=

# Configuração pública do Producer Kafka; nenhum segredo é necessário.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
WEATHER_POLL_INTERVAL_SECONDS=300